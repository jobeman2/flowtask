# ==============================================================================
# FLOWTASK ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Application
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Database (PostgreSQL - Local or Hosted like Supabase/Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowtask?schema=public"

# Cache & Queues (Redis - Local or Hosted like Upstash)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Telegram Bot Integration
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_USERNAME="FlowTaskDevBot"
# Webhook Secret Token for production webhook verification
TELEGRAM_WEBHOOK_SECRET="telegram-webhook-secret-token"
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL="https://api.yourdomain.com/api/v1/telegram/webhook"

# Telegram Mini App Configuration
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="FlowTaskDevBot"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# AI Integration (Optional / Phase 6)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
